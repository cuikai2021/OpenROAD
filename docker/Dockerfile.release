ARG DEPS_IMAGE_TAG
ARG EDEN_GIT_SHA1



FROM ${DEPS_IMAGE_TAG} AS eden_build_stage
COPY ./Eden-src /Eden
WORKDIR /Eden
ARG EDEN_GIT_SHA1
RUN cmake -DEDEN_GIT_SHA1=${EDEN_GIT_SHA1} -B build . && cmake --build build -j 8

ARG DEPS_IMAGE_TAG
FROM ${DEPS_IMAGE_TAG} AS deps_stage
RUN apt-get install -y time libreadline-dev pkg-config 
RUN \
  set -eu; \
  apt-get install -y klayout; \
  wget https://www.klayout.org/downloads/Ubuntu-20/klayout_0.26.6-1_amd64.deb; \
  dpkg -i klayout_0.26.6-1_amd64.deb; \
  rm -f klayout_0.26.6-1_amd64.deb; 


FROM deps_stage AS yosys_build_stage
COPY ./yosys /yosys
WORKDIR /yosys
RUN  make

FROM deps_stage AS maple_build_stage
COPY ./maple /maple
WORKDIR /maple
RUN  ./etc/Build.sh

FROM deps_stage
RUN mkdir -p /usr/local/share/yosys
COPY --from=yosys_build_stage /yosys/yosys* /usr/local/bin
COPY --from=yosys_build_stage /yosys/share/* /usr/local/share/yosys
COPY --from=eden_build_stage /Eden/build/src/eden /usr/local/bin
RUN mkdir -p /Eden-flow
WORKDIR /Eden-flow
RUN mkdir -p /Eden-flow/flow
RUN chmod o+rw -R /Eden-flow/flow