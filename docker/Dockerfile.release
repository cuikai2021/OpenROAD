ARG FROM_IMAGE_TAG
ARG EDEN_GIT_SHA1
ARG YOSYS_IMAGE_TAG

FROM ${FROM_IMAGE_TAG} AS build_stage
ARG FROM_IMAGE_TAG
COPY . /Eden
WORKDIR /Eden
RUN cmake -DEDEN_GIT_SHA1=${EDEN_GIT_SHA1} -B build . && cmake --build build -j 8

FROM ${YOSYS_IMAGE_TAG} AS yosys_stage
ARG YOSYS_IMAGE_TAG

FROM ubuntu:20.04
COPY --from=yosys_stage /yosys/yosys* /usr/local/bin
COPY --from=build_stage /Eden/build/src/eden /usr/local/bin
WORKDIR /Eden