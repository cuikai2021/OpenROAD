ARG DEPS_IMAGE_TAG
ARG EDEN_GIT_SHA1
ARG YOSYS_IMAGE_TAG
FROM ${DEPS_IMAGE_TAG} AS build_stage
COPY . /Eden
WORKDIR /Eden
RUN cmake -DEDEN_GIT_SHA1=${EDEN_GIT_SHA1} -B build . && cmake --build build -j 8

ARG DEPS_IMAGE_TAG
ARG YOSYS_IMAGE_TAG
FROM ${YOSYS_IMAGE_TAG} AS yosys_stage

ARG DEPS_IMAGE_TAG
FROM ${DEPS_IMAGE_TAG}
RUN apt install -y libreadline8 klayout
COPY --from=yosys_stage /yosys/yosys* /usr/local/bin
COPY --from=build_stage /Eden/build/src/eden /usr/local/bin
WORKDIR /Eden