ARG FROM_IMAGE_TAG
FROM ${FROM_IMAGE_TAG}

ARG EDEN_GIT_SHA1

COPY . /Eden
WORKDIR /Eden

# Build
RUN cmake -DEDEN_GIT_SHA1=${EDEN_GIT_SHA1} -B build . && cmake --build build -j 8

RUN mv ./build/src/eden /tmp/
RUN mv ./build/src/openroad /tmp/
RUN rm -r .*
RUN mv /tmp/eden ./build/src
RUN mv /tmp/openroad ./build/src