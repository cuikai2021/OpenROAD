ARG EDEN_BUILD_IMAGE
ARG EDEN_GIT_SHA1
ARG JOBS_NUM

FROM ${EDEN_BUILD_IMAGE} AS maple_build_stage
COPY ./maple /maple
RUN \
    cd maple \
    && \ 
    bash etc/Build.sh
WORKDIR /maple

FROM ${EDEN_BUILD_IMAGE} AS eden_build_stage
COPY ./Eden-src /Eden
WORKDIR /Eden
ARG EDEN_GIT_SHA1
ARG JOBS_NUM=8
RUN cmake -DEDEN_GIT_DESCRIBE=${EDEN_GIT_SHA1} -B build . && cmake --build build -j ${JOBS_NUM}

ARG EDEN_BUILD_IMAGE
FROM ${EDEN_BUILD_IMAGE} AS deps_stage
ADD ./Eden-src/src/Banyan/banyan-integrate/*.so /Eden-flow/flow/libs/
ENV LD_LIBRARY_PATH=/Eden-flow/flow/libs/

FROM deps_stage AS yosys_build_stage
COPY ./yosys /yosys
WORKDIR /yosys
ARG JOBS_NUM=8
RUN  make -j ${JOBS_NUM}

FROM deps_stage
ADD ./klayout_0.26.6-1_amd64.deb .
RUN \
  set -eu; \
  apt-get update && apt-get install -y klayout time libreadline-dev pkg-config imagemagick ssh; \
  dpkg -i klayout_0.26.6-1_amd64.deb; \
  rm -f klayout_0.26.6-1_amd64.deb;
RUN mkdir -p /usr/local/share/yosys
ADD ./ossutil64 /usr/local/bin/ossutil64
ADD modules/release/tools/start_logtail.sh /Eden-flow/start_logtail.sh
ADD modules/release/tools/gds2png.sh /Eden-flow/gds2png.sh
ADD modules/release/tools/gds2png.txt /Eden-flow/gds2png.txt
ADD ./envsubst /usr/local/bin/envsubst
ADD modules/release/tools/rpt_catcher.py /Eden-flow/rpt_catcher.py
ADD modules/release/tools/klayoutrc /Eden-flow/klayoutrc
RUN chmod +x /usr/local/bin/ossutil64 /usr/local/bin/envsubst /Eden-flow/gds2png.sh

COPY --from=maple_build_stage /maple/build/src/maple /usr/local/bin/sv2v
COPY --from=maple_build_stage /maple/build/src/yosys* /usr/local/bin/
COPY --from=maple_build_stage /maple/yosys/share/* /usr/local/share/yosys/
COPY --from=maple_build_stage /maple/doc/hmerger/example /doc/hmerger/example
COPY --from=maple_build_stage /maple/design/iscas/sky130_fd_sc_hd__ss_n40C_1v40.lib /doc/hmerger/example/input/
COPY --from=yosys_build_stage /yosys/yosys* /usr/local/bin/origin-yosys/
COPY --from=eden_build_stage /Eden/build/src/eden /usr/local/bin
COPY ./Eden-src/src/linden/gpl/bin /usr/local/bin/
RUN mkdir -p /Eden-flow
WORKDIR /Eden-flow
RUN mkdir -p /Eden-flow/flow
RUN chmod o+rw -R /Eden-flow/flow
RUN mv /usr/local/bin/yosys /usr/local/bin/maple
RUN ln -s /usr/local/bin/origin-yosys/yosys /usr/local/bin/yosys
RUN touch ~/.tchlsh-history
