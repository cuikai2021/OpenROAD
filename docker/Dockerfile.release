ARG FROM_IMAGE_TAG
FROM ${FROM_IMAGE_TAG} AS build_stage

ARG EDEN_GIT_SHA1

COPY . /Eden
WORKDIR /Eden

# Build
RUN cmake -DEDEN_GIT_SHA1=${EDEN_GIT_SHA1} -B build . && cmake --build build -j 8


ARG YOYSY_IMAGE_TAG
FROM ${YOYSY_IMAGE_TAG} AS yosys_stage


FROM ubuntu:20.04

COPY --from=yosys_stage /yosys/yosys* /usr/local/bin
COPY --from=build_stage /Eden/src/eden /usr/local/bin

WORKDIR /Eden