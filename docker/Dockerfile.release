ARG DEPS_IMAGE_TAG
ARG EDEN_GIT_SHA1

FROM ${DEPS_IMAGE_TAG} AS eden_build_stage
COPY . /Eden
WORKDIR /Eden
ARG EDEN_GIT_SHA1
RUN cmake -DEDEN_GIT_SHA1=${EDEN_GIT_SHA1} -B build . && cmake --build build -j 8

ARG DEPS_IMAGE_TAG
FROM ${DEPS_IMAGE_TAG} AS yosys_build_stage
COPY ./yosys /yosys
WORKDIR /yosys
RUN apt update && apt install -y libreadline-dev klayout pkg-config && make

ARG DEPS_IMAGE_TAG
FROM ${DEPS_IMAGE_TAG}
RUN apt update && apt install -y time libreadline-dev klayout pkg-config
COPY --from=yosys_build_stage /yosys/yosys* /usr/local/bin
COPY --from=yosys_build_stage /yosys/share/* /usr/local/share
COPY --from=eden_build_stage /Eden/build/src/eden /usr/local/bin
WORKDIR /Eden