#!/bin/bash

ARG ubuntuVersion=20.04

ARG copyImage=ubuntu:${ubuntuVersion}
FROM $copyImage AS deps
USER root 

COPY ./etc/DependencyInstaller.sh /tmp
RUN bash /tmp/DependencyInstaller.sh -dev 
RUN rm -f /tmp/DependencyInstaller.sh

FROM deps AS deps-debug
RUN apt install -y liboctave-dev gdb

FROM deps-debug AS deps-debug-vscode
COPY ./vscode-extensions /root/.vscode-server/extensions
