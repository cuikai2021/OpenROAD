ARG EDEN_BUILD_IMAGE
FROM ${EDEN_BUILD_IMAGE} as build

COPY . /Eden
WORKDIR /Eden

# Build
RUN cmake \
    -DCMAKE_BUILD_TYPE=Debug \
    -DCMAKE_CXX_FLAGS="-fprofile-arcs \ 
    -ftest-coverage" \
    -DCMAKE_EXE_LINKER_FLAGS=-lgcov \ 
    -B build . && cmake --build build -j 8

# final stage
FROM ${EDEN_BUILD_IMAGE}

RUN --mount=type=bind,src=/Eden/build,dst=/tmp,from=build \
    mkdir -p /Eden/build && \
    cd /tmp && \
    find . -name "*.gcno" -exec cp -p --parents {} /Eden/build \;
COPY --from=build /Eden/build/src/eden /build/bin/eden

# copy BANYAN file
COPY src/Banyan/banyan-integrate/banyan /build/bin/
COPY src/Banyan/banyan-integrate/maxhs /build/bin/
COPY src/Banyan/banyan-integrate/banyan*.so /build/lib/

# copy LINDEN file
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/build/lib/
ENV PATH=$PATH:/build/bin/
COPY src/linden/gpl/bin/* /build/bin/
COPY src/linden/gpl/lib/liblegendre_rule_fast.so /build/lib/liblegendre_rule_fast.so

# install lcov
RUN apt-get update && \
    apt install -y lcov time
