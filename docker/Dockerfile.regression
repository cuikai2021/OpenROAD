ARG FROM_IMAGE_TAG
FROM ${FROM_IMAGE_TAG}

ARG EDEN_GIT_SHA1

COPY . /Eden
WORKDIR /Eden

# Build
RUN cmake -DEDEN_GIT_SHA1=${EDEN_GIT_SHA1} -DGTEST=ON -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS="-fprofile-arcs -ftest-coverage" -DCMAKE_EXE_LINKER_FLAGS=-lgcov -B build . && cmake --build build -j 8



