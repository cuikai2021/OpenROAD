ARG eden_build_image
FROM ${eden_build_image}

ARG EDEN_GIT_SHA1

COPY . /Eden
WORKDIR /Eden

# Build
RUN cmake -DEDEN_GIT_DESCRIBE=${EDEN_GIT_SHA1} -DGTEST=ON -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS="-fprofile-arcs -ftest-coverage" -DCMAKE_EXE_LINKER_FLAGS=-lgcov -B build . && cmake --build build -j 8
