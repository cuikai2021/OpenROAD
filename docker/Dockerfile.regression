FROM registry.cn-shanghai.aliyuncs.com/openroad/env_openroad:0207

ARG EDEN_GIT_SHA1

COPY . /Eden
WORKDIR /Eden

RUN wget -P /usr/bin  http://gosspublic.alicdn.com/ossutil/1.7.3/ossutil64
RUN chmod 755 /usr/bin/ossutil64

ARG aki
ARG aks

RUN ossutil64 config -e oss-cn-shanghai.aliyuncs.com -i ${aki} -k ${aks}

# Build
RUN cmake -DEDEN_GIT_SHA1=${EDEN_GIT_SHA1} -B build . && cmake --build build -j 8
RUN ln -s /Eden/build/src/eden /Eden/build/src/openroad



