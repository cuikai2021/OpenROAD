find_package(Protobuf REQUIRED)
message(STATUS "protobuf: ${Protobuf_VERSION}")

function(protoc)
    if(${ARGC} EQUAL 0)
        message(FATAL_ERROR "protoc requires a name of resulting lib.")
    endif()

    set(libname ${ARGV0})
    set(protos "")
    set(pb_dir "")
    set(cpp_out "")
    set(i 1)
    while(${i} LESS ${ARGC})
        set(arg ${ARGV${i}})
        if(${arg} STREQUAL "PB_DIR")
            math(EXPR nxt_i "${i} + 1")
            if(${nxt_i} GREATER_EQUAL ${ARGC})
                message(FATAL_ERROR "a directory is required after PB_DIR.")
            endif()
            set(pb_dir ${ARGV${nxt_i}})
            math(EXPR i "${nxt_i} + 1")
        elseif(${arg} STREQUAL "CPP_OUT")
            math(EXPR nxt_i "${i} + 1")
            if(${nxt_i} GREATER_EQUAL ${ARGC})
                message(FATAL_ERROR "a directory is required after CPP_OUT.")
            endif()
            set(cpp_out ${ARGV${nxt_i}})
            math(EXPR i "${nxt_i} + 1")
        else()
            list(APPEND protos ${arg})
            math(EXPR i "${i} + 1")
        endif()
    endwhile()
    if("${protos}" STREQUAL "")
        message(FATAL_ERROR ".proto files are required.")
    endif()
    if("${cpp_out}" STREQUAL "")
        message(FATAL_ERROR "CPP_OUT are required.")
    endif()
    if("${pb_dir}" STREQUAL "")
        message(FATAL_ERROR "PB_DIR are required.")
    endif()

    file(MAKE_DIRECTORY ${cpp_out})

    set(cpps "")
    foreach(pb IN LISTS protos)
        get_filename_component(pb_base ${pb} NAME_WLE)
        set(cpp "${cpp_out}/${pb_base}.pb.cc")
        list(APPEND cpps ${cpp})
    endforeach()

    set(outs "")
    foreach(pb IN LISTS protos)
        get_filename_component(pb_base ${pb} NAME_WLE)
        list(APPEND outs "${cpp_out}/${pb_base}.pb.hh")
        list(APPEND outs "${cpp_out}/${pb_base}.pb.cc")
    endforeach()

    add_custom_command(
        OUTPUT ${outs}
        COMMAND ${PROTOBUF_PROTOC_EXECUTABLE} -I ${pb_dir} --cpp_out ${cpp_out} ${protos}
    )

    add_library(${libname} ${cpps})
    target_link_libraries(${libname} PUBLIC protobuf::libprotobuf)
    target_include_directories(${libname} PUBLIC ${cpp_out})
endfunction()
