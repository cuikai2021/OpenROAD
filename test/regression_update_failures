#!/bin/sh
# The next line is executed by /bin/sh, but not Tcl \
exec tclsh $0 ${1+"$@"}

set test_dir [file dirname [file normalize [info script]]]
set openroad_dir [file dirname $test_dir]
set curtime [clock seconds]
set ossurl "https://icbench-devops.oss-cn-shanghai.aliyuncs.com/regression-$curtime"
set osspath "oss://icbench-devops/regression-$curtime"

array set all_test_dirs { ifp "src/ifp/test" dbSta "src/dbSta/test" ppl "src/ppl/test" \
pdngen "src/pdngen/test" ICeWall "src/ICeWall/test" mpl "src/mpl/test" rsz "src/rsz/test" replace "src/replace/test" \
TritonCTS "src/TritonCTS/test" dpl "src/dpl/test" psm "src/psm/test" grt "src/grt/test" tap "src/tap/test" \
antenna_checker "src/antenna_checker/test" OpenDB "src/OpenDB/test" OpenRCX "src/OpenRCX/test" PartitionMgr "src/PartitionMgr/test" \
TritonRoute "src/TritonRoute/test" }

proc read_failures_item { failures_file } {
    set items [list];
    if { [catch {set fp [open $failures_file r]} result] } {
        printf "open file '$failures_file' error.";
        exit;
    }
    puts $failures_file;
    while {1} {
        set line [gets $fp];
        lappend items $line;
        if {[eof $fp]} {
            close $fp;
            break;
        }
    }
    return $items;
}

proc update_failure_item { project test_dir failure_item} {
    global openroad_dir;
    global osspath;
    set osspath_result "$osspath/$project/results/";
    set osspath_expectation "$osspath/$project/expectation/";

    set test_results_dir "$openroad_dir/$test_dir/results";

    set ok_file "$test_dir/$failure_item.ok";
    set defok_file "$test_dir/$failure_item.defok";
    set result_ok_file "$test_dir/results/$failure_item.log";
    set result_defok_file "$test_dir/results/$failure_item.def";

    if { [file exists $ok_file] == 1} { 
        exec ossutil64 cp $ok_file $osspath_expectation;
    }

    if { [file exists $defok_file] == 1} { 
        exec ossutil64 cp $defok_file $osspath_expectation;
    }

    if { [file exists $result_ok_file] == 1} { 
        exec ossutil64 cp $result_ok_file $osspath_result;
    }

    if { [file exists $result_defok_file] == 1} { 
        exec ossutil64 cp $result_defok_file $osspath_result;
    }
}

proc update_failures { project test_dir } {
    global openroad_dir;
    global osspath;
    set osspath_project "$osspath/$project/";
    set failures_file "$openroad_dir/$test_dir/results/failures";
    if { [file exists $failures_file] == 1} {               
        puts "$project run regression failures";
        set failure_items [read_failures_item $failures_file];
        if { [llength failure_items] > 0 } {
            exec ossutil64 cp $failures_file $osspath_project;
            foreach item $failure_items {
                update_failure_item $project $test_dir $item;
            }
        }
    } else {
        puts "$project run regression success";
    }
}

foreach { name dir } [array get all_test_dirs] {
    update_failures $name $dir;
}