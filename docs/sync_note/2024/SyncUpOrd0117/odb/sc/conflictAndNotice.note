# TODO

static dbInst*
findInst(dbBlock* blk, utl::Logger* _logger, const char* name) {
  dbInst* inst = nullptr;
  std::string n = name;
  size_t pos = 0;
  while (!(inst = blk->findInst(n.c_str()))) {
	 pos = n.find('/', pos);
	 if (pos == -1) break;
	 n[pos] = '.';
  }
  if (!inst)
    _logger->warn(utl::ODB, 3001, "error: cannot find instance: %s", name);
// TODO : sync up ord, sizeOnly is removed by ord. Can't decide whether to keep it.
//   inst->setSizeOnly(true);
  return inst;
}



src/odb/src/swig/common/swig_common.cpp

# since createChip interface change, getTech from db & compare lib->getTech() and db->getTch()

odb::dbChip* read_def_incremental(odb::dbDatabase* db, std::string path)
{
  utl::Logger* logger = new utl::Logger(NULL);
  std::vector<odb::dbLib*> libs;
  for (auto* lib : db->getLibs()) {
    if (lib->getTech() == db->getTech()) {
      libs.push_back(lib);
    }
  }
  odb::defin defParser(db, logger, odb::defin::INCREMENTAL);
  return defParser.createChip(libs, path.c_str(), db->getTech());
}



