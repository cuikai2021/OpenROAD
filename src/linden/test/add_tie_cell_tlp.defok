VERSION 5.8 ;
DIVIDERCHAR "|" ;
BUSBITCHARS "[]" ;
DESIGN ldn-add-tie-cell-tlp ;
UNITS DISTANCE MICRONS 2000 ;
DIEAREA ( 0 0 ) ( 38000 28000 ) ;
ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 0 0 N DO 4 BY 1 STEP 380 0 ;
ROW ROW_1 FreePDK45_38x28_10R_NP_162NW_34O 0 2800 FS DO 4 BY 1 STEP 380 0 ;
ROW ROW_2 FreePDK45_38x28_10R_NP_162NW_34O 0 5600 FS DO 4 BY 1 STEP 380 0 ;
ROW ROW_3 FreePDK45_38x28_10R_NP_162NW_34O 0 8400 FS DO 4 BY 1 STEP 380 0 ;
COMPONENTS 5 ;
    - TIEH_0 LOGIC1_X1 + PLACED ( 380 5600 ) FS ;
    - TIEL_0 LOGIC0_X1 + PLACED ( 760 2800 ) FS ;
    - TIEL_d_led_clr LOGIC0_X1 + PLACED ( 760 0 ) N ;
    - cell0 INV_X1 + PLACED ( 0 0 ) N ;
    - cell1 INV_X1 + PLACED ( 0 2800 ) FS ;
END COMPONENTS
PINS 1 ;
    - d_led_clr + NET d_led_clr + DIRECTION OUTPUT + USE SIGNAL
      + PORT
        + LAYER metal3 ( -520 -100 ) ( 520 100 )
        + PLACED ( 0 0 ) N ;
END PINS
NETS 3 ;
    - TIEH_NET_0 ( cell1 A ) ( TIEH_0 Z ) + USE SIGNAL ;
    - TIEL_NET_0 ( cell0 A ) ( TIEL_0 Z ) + USE SIGNAL ;
    - d_led_clr ( PIN d_led_clr ) ( TIEL_d_led_clr Z ) + USE SIGNAL ;
END NETS
END DESIGN
