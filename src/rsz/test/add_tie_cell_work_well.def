VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 120000 110000 ) ;
ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 0 0 FS DO 630 BY 1 STEP 190 0 ;
ROW ROW_1 FreePDK45_38x28_10R_NP_162NW_34O 0 1400 N DO 630 BY 1 STEP 190 0 ;
ROW ROW_2 FreePDK45_38x28_10R_NP_162NW_34O 0 2800 FS DO 630 BY 1 STEP 190 0 ;
TRACKS Y 70 DO 786 STEP 140 LAYER metal1 ;
TRACKS X 95 DO 316 STEP 190 LAYER metal2 ;
TRACKS Y 70 DO 786 STEP 140 LAYER metal3 ;
TRACKS X 95 DO 214 STEP 280 LAYER metal4 ;
TRACKS Y 70 DO 393 STEP 280 LAYER metal5 ;
TRACKS X 95 DO 214 STEP 280 LAYER metal6 ;
TRACKS Y 70 DO 138 STEP 800 LAYER metal7 ;
TRACKS X 95 DO 75 STEP 800 LAYER metal8 ;
TRACKS Y 70 DO 69 STEP 1600 LAYER metal9 ;
TRACKS X 95 DO 38 STEP 1600 LAYER metal10 ;
COMPONENTS 15 ;
    - t1 INV_X1 + PLACED ( 200 200 ) N ;
    - u1 BUF_X1 + PLACED ( 2000 200 ) N ;
    - u2 BUF_X1 + PLACED ( 4000 200 ) N ;
    - u3 BUF_X1 + PLACED ( 6000 200 ) N ;
    - u4 BUF_X1 + PLACED ( 8000 200 ) N ;
    - u5 BUF_X1 + PLACED ( 10000 200 ) N ;
    - u6 BUF_X1 + PLACED ( 12000 200 ) N ;
    - u7 BUF_X1 + PLACED ( 14000 200 ) N ;
    - u8 BUF_X1 + PLACED ( 16000 200 ) N ;
    - u9 BUF_X1 + PLACED ( 18000 200 ) N ;
    - u10 BUF_X1 + PLACED ( 20000 200 ) N ;
    - pad1 PAD + FIXED ( 0 6000 ) N ;
    - pad2 PAD + FIXED ( 30000 6000 ) N ;
    - pad3 PAD + FIXED ( 60000 6000 ) N ;
    - pad4 PAD + FIXED ( 90000 6000 ) N ;
END COMPONENTS
NETS 5 ;
    - n1 ( t1 ZN ) ( u1 A ) ( u2 A ) ( pad1 TRIEN ) ( pad2 TRIEN ) + USE SIGNAL ;
    - n2 ( u3 A ) ( u4 A ) ( pad3 TRIEN ) + USE POWER ;
    - n3 ( u5 A ) ( u6 A ) ( pad4 TRIEN ) + USE GROUND ;
    - n4 ( u7 A ) ( u8 A ) + USE POWER ;
    - n5 ( u9 A ) ( u10 A ) + USE GROUND ;
END NETS
END DESIGN
