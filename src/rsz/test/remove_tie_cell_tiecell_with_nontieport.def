VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN top ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 -1000 ) ( 25000 5000 ) ;

ROW ROW_0 FreePDK45_38x28_10R_NP_162NW_34O 0 0 FS DO 130 BY 1 STEP 190 0 ;
ROW ROW_1 FreePDK45_38x28_10R_NP_162NW_34O 0 1400 N DO 130 BY 1 STEP 190 0 ;
ROW ROW_2 FreePDK45_38x28_10R_NP_162NW_34O 0 2800 FS DO 130 BY 1 STEP 190 0 ;

TRACKS Y 70 DO 786 STEP 140 LAYER metal1 ;
TRACKS X 95 DO 316 STEP 190 LAYER metal2 ;
TRACKS Y 70 DO 786 STEP 140 LAYER metal3 ;
TRACKS X 95 DO 214 STEP 280 LAYER metal4 ;
TRACKS Y 70 DO 393 STEP 280 LAYER metal5 ;
TRACKS X 95 DO 214 STEP 280 LAYER metal6 ;
TRACKS Y 70 DO 138 STEP 800 LAYER metal7 ;
TRACKS X 95 DO 75 STEP 800 LAYER metal8 ;
TRACKS Y 70 DO 69 STEP 1600 LAYER metal9 ;
TRACKS X 95 DO 38 STEP 1600 LAYER metal10 ;

COMPONENTS 4 ;
    - kept_fake_tie_low AND2_X1 + PLACED ( 2000 1400 ) N ;
    - kept_fake_tie_high OR2_X1 + PLACED ( 4000 1400 ) N ;

    - removed_fake_tie_low AND2_X1 + PLACED ( 5000 1400 ) N ;
    - removed_fake_tie_high OR2_X1 + PLACED ( 6000 1400 ) N ;
END COMPONENTS

PINS 5 ;
    - pin_lo_out1 + NET fake_tie_lo_out1 + DIRECTION OUTPUT + USE SIGNAL
        + LAYER metal2 ( -100 -200 ) ( 100 200 ) + FIXED ( 3000 -600 ) N ;
    - pin_in + NET pin_in + DIRECTION INPUT + USE SIGNAL
        + LAYER metal2 ( -100 -200 ) ( 100 200 ) + FIXED ( 4000 -600 ) N ;
    - pin_hi_out1 + NET fake_tie_hi_out1 + DIRECTION OUTPUT + USE SIGNAL
        + LAYER metal2 ( -100 -200 ) ( 100 200 ) + FIXED ( 5000 -600 ) N ;

    - pin_lo_out2 + NET fake_tie_lo_out2 + DIRECTION OUTPUT + USE SIGNAL
        + LAYER metal2 ( -100 -200 ) ( 100 200 ) + FIXED ( 6000 -600 ) N ;
    - pin_hi_out2 + NET fake_tie_hi_out2 + DIRECTION OUTPUT + USE SIGNAL
        + LAYER metal2 ( -100 -200 ) ( 100 200 ) + FIXED ( 7000 -600 ) N ;
END PINS

NETS 5 ;
    - fake_tie_lo_out1 ( PIN pin_lo_out1 ) ( kept_fake_tie_low  ZN ) + USE SIGNAL ;
    - pin_in ( PIN pin_in ) ( kept_fake_tie_low A1 ) ( kept_fake_tie_high A1 ) + USE SIGNAL ;
    - fake_tie_hi_out1 ( PIN pin_hi_out1 ) ( kept_fake_tie_high ZN ) + USE SIGNAL ;

    - fake_tie_lo_out2 ( PIN pin_lo_out2 ) ( removed_fake_tie_low  ZN ) + USE SIGNAL ;
    - fake_tie_hi_out2 ( PIN pin_hi_out2 ) ( removed_fake_tie_high ZN ) + USE SIGNAL ;
END NETS
END DESIGN
